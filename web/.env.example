# Kopioi tiedostoksi .env.local ja poista kommentti, jos haluat pilvitallennuksen päälle.
# Tyhjä arvo = peli tallentaa vain selaimen localStorageen.
#
# Paikallisesti (func start + Vite-proxy):
# VITE_API_URL=/api
#
# Pilvessä (Terraformin output function_app_url + /api):
# VITE_API_URL=https://func-kantama-dev-xxxxx.azurewebsites.net/api
VITE_API_URL=
