# Copy to .env.local and uncomment a line if you want cloud save on.
# Empty value = the game saves only to the browser's localStorage.
#
# Locally (func start + Vite proxy):
# VITE_API_URL=/api
#
# In the cloud (Terraform output function_app_url + /api):
# VITE_API_URL=https://func-kantama-dev-xxxxx.azurewebsites.net/api
VITE_API_URL=
